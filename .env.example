# ---------------------------------------------------------------------------
# Neon / Vercel Postgres
# ---------------------------------------------------------------------------
# DATABASE_URL  -> pooled connection, used by the app at runtime
# DIRECT_URL    -> direct connection, used by the Prisma CLI (migrations / db push)
# The Vercel Neon integration injects both automatically.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js — generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# TMDB — https://www.themoviedb.org/settings/api
# Use the "API Read Access Token" (the long eyJ... token), not the short API key.
# ---------------------------------------------------------------------------
TMDB_API_READ_TOKEN=""

# ---------------------------------------------------------------------------
# AniList needs no key. Public API is rate limited to 30-90 req/min.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Public base URL of the deployment (used for auth redirects / metadata)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
